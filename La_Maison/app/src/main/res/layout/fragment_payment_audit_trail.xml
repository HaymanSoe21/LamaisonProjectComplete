<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A">

    <!-- 1. FIXED NAVY HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:layout_marginTop="15dp">

            <ImageView
                android:id="@+id/tvBackToDashboard"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_chevron_left"
                android:padding="6dp"
                android:background="@drawable/bg_input_rounded"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="La Maison"
                android:fontFamily="@font/parisienne"
                android:textSize="28sp"
                android:textColor="#FFFFFF" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MANAGER DASHBOARD"
            android:fontFamily="@font/playfair_display"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:letterSpacing="0.15"
            android:layout_gravity="center"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audit Trail"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- 2. SCROLLABLE BODY CONTAINER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sheet_light_grey"
        android:orientation="vertical">

        <!-- INLINE 1-BUTTON DYNAMIC FILTER BAR (Matched to Maintenance Hub Style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="8dp">

            <!-- Dynamic Header Title -->
            <TextView
                android:id="@+id/tvFeedTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PROCESSED TRANSACTIONS"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <!-- Compact Pill Action Button with Calendar Icon -->
            <TextView
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="FILTER"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_signout"
                android:backgroundTint="#0F172A"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:drawableStart="@android:drawable/ic_menu_today"
                android:drawablePadding="6dp"
                android:drawableTint="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- AUDIT SLIPS RECYCLER VIEW -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAuditSlips"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp"
            android:overScrollMode="never" />

    </LinearLayout>
</LinearLayout>