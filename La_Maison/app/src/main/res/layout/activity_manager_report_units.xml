<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical">

    <!-- FIXED HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="36dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:layout_marginTop="15dp">

            <ImageView
                android:id="@+id/btnBackArrow"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_chevron_left"
                android:paddingVertical="8dp"
                android:paddingHorizontal="5dp"
                android:background="@drawable/bg_input_rounded"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="La Maison"
                android:fontFamily="@font/parisienne"
                android:textSize="26sp"
                android:textColor="#FFFFFF" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUITE INVENTORY MANAGEMENT"
            android:fontFamily="@font/playfair_display"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:letterSpacing="0.15"
            android:layout_gravity="center"
            android:layout_marginTop="5dp" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Propose New Suite"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_sheet_light_grey"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:id="@+id/viewProposalForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COMPLETE SUITE SPECIFICATIONS"
                    android:textSize="11sp"
                    android:textColor="#64748B"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Unit Code with Verify Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="14dp">

                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unit Code" android:textColor="#64748B" android:textSize="11sp"/>
                        <TextView
                            android:id="@+id/btnVerifyUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="VERIFY"
                            android:textColor="#2563EB"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:clickable="true"
                            android:focusable="true" />
                    </RelativeLayout>

                    <EditText
                        android:id="@+id/etUnitCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="DIA-6B"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@null"
                        android:paddingTop="4dp" />
                </LinearLayout>

                <!-- Action Type Spinner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Action Type" android:textColor="#64748B" android:textSize="11sp"/>
                    <Spinner
                        android:id="@+id/spinnerActionType"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Unit Number -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unit Number" android:textColor="#64748B" android:textSize="11sp"/>
                    <EditText
                        android:id="@+id/etUnitNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="6B"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@null"
                        android:paddingTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Building Name" android:textColor="#64748B" android:textSize="11sp"/>
                    <EditText
                        android:id="@+id/etBuildingName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="La Maison Diamond Wing"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@null"
                        android:paddingTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Property Address" android:textColor="#64748B" android:textSize="11sp"/>
                    <EditText
                        android:id="@+id/etPropertyAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="123 Diamond Avenue, Wing A"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@null"
                        android:paddingTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_white"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:layout_marginEnd="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Base Rent ($)" android:textColor="#64748B" android:textSize="11sp"/>
                        <EditText
                            android:id="@+id/etBaseRent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="1750"
                            android:inputType="number"
                            android:textColor="#0F172A"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:background="@null"
                            android:paddingTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:background="@drawable/bg_card_white"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Occupancy Status" android:textColor="#64748B" android:textSize="11sp"/>
                        <Spinner
                            android:id="@+id/spinnerOccupancy"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="5dp"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnSubmitProposal"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Submit Suite Action"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#0F172A"
                    app:cornerRadius="14dp"
                    android:elevation="4dp" />
                <TextView
                    android:id="@+id/btnClearForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clear Form"
                    android:gravity="center"
                    android:textColor="#64748B"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/viewApprovedDirectory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APPROVED DB ADDITIONS (RECENT FIRST)"
                    android:textSize="11sp"
                    android:textColor="#64748B"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/approvedUnitsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavUnits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="16dp"
        app:itemIconTint="@color/selector_bottom_nav"
        app:itemTextColor="@color/selector_bottom_nav"
        app:menu="@menu/menu_report_units_nav" />
</LinearLayout>