<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:layout_marginTop="15dp">

            <ImageView
                android:id="@+id/btnBackHeader"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_chevron_left"
                android:paddingVertical="8dp"
                android:paddingHorizontal="5dp"
                android:background="@drawable/bg_input_rounded"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="La Maison"
                android:fontFamily="@font/parisienne"
                android:textSize="26sp"
                android:textColor="#FFFFFF" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAINTENANCE HUB"
            android:fontFamily="@font/playfair_display"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:letterSpacing="0.15"
            android:layout_gravity="center"
            android:layout_marginTop="5dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Submit Request"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_sheet_light_grey"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Issue Title"
                    android:textColor="#334155"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etIssueTitle"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="e.g., Leaking Kitchen Sink"
                    android:textColorHint="#94A3B8"
                    android:background="@drawable/bg_input_rounded"
                    android:backgroundTint="#F8FAFC"
                    android:paddingHorizontal="16dp"
                    android:textSize="15sp"
                    android:textColor="#0F172A"
                    android:inputType="textCapSentences"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textColor="#334155"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp"/>

                <Spinner
                    android:id="@+id/spinnerCategory"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_rounded"
                    android:backgroundTint="#F8FAFC"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detailed Description"
                    android:textColor="#334155"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:hint="Provide details about the issue..."
                    android:textColorHint="#94A3B8"
                    android:background="@drawable/bg_input_rounded"
                    android:backgroundTint="#F8FAFC"
                    android:padding="16dp"
                    android:gravity="top|start"
                    android:textSize="15sp"
                    android:textColor="#0F172A"
                    android:inputType="textMultiLine"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload Photo (Optional)"
                    android:textColor="#334155"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:id="@+id/btnUploadPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_input_rounded"
                    android:backgroundTint="#F1F5F9"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvUploadStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to Upload Issue Photo 📸"
                        android:textColor="#3B82F6"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JPG or PNG up to 5MB"
                        android:textColor="#9CA3AF"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnSubmitTicket"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Submit Ticket"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#0F172A"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvCancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancel Request"
                android:gravity="center"
                android:textColor="#64748B"
                android:textStyle="bold"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>