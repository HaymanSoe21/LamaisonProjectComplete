<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <!-- Luxury Brand Header Icon -->
    <TextView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:text="LM"
        android:fontFamily="@font/parisienne"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:background="@drawable/bg_input_rounded"
        android:backgroundTint="#0F172A"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sign Out of Your Account?"
        android:fontFamily="@font/playfair_display"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You will need to re-authenticate with your credentials to access your role-based services."
        android:textSize="13sp"
        android:textColor="#64748B"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="24dp" />

    <!-- Action Pill Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Stay Logged In"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#475569"
            app:backgroundTint="#F1F5F9"
            app:cornerRadius="12dp"
            android:layout_marginEnd="6dp"
            android:elevation="0dp" />

        <Button
            android:id="@+id/btnDialogConfirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Sign Out"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#0F172A"
            app:cornerRadius="12dp"
            android:layout_marginStart="6dp"
            android:elevation="2dp" />
    </LinearLayout>

</LinearLayout>