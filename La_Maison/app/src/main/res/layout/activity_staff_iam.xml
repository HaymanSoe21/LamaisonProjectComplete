<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical">

    <!-- Top Navy Header Block -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="36dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:layout_marginTop="15dp">

            <!-- Back Button -->
            <ImageView
                android:id="@+id/btnBackArrow"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_chevron_left"
                android:paddingVertical="8dp"
                android:paddingHorizontal="5dp"
                android:background="@drawable/bg_input_rounded"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="La Maison"
                android:fontFamily="@font/parisienne"
                android:textSize="26sp"
                android:textColor="#FFFFFF" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXECUTIVE GOVERNANCE"
            android:fontFamily="@font/playfair_display"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:letterSpacing="0.15"
            android:layout_gravity="center"
            android:layout_marginTop="5dp" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Staff IAM &amp; Security"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Scrollable Content Sheet -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_sheet_light_grey"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ISSUE EXECUTIVE TOKEN"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Input Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manager Identifier"
                    android:textColor="#64748B"
                    android:textSize="11sp"/>

                <EditText
                    android:id="@+id/etManagerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g., LM-MGR-01"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@null"
                    android:paddingTop="8dp" />
            </LinearLayout>

            <!-- Generate Button -->
            <Button
                android:id="@+id/btnGenerateToken"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Generate Security Token"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#B45309"
                app:cornerRadius="14dp"
                android:elevation="4dp"
                android:layout_marginBottom="36dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMERGENCY PROTOCOL"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Kill Switch Button -->
            <Button
                android:id="@+id/btnKillSwitch"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="EMERGENCY KILL SWITCH"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#991B1B"
                app:cornerRadius="14dp"
                android:elevation="4dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>