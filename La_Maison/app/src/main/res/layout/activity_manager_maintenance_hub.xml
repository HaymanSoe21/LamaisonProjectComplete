<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- 1. FIXED NAVY HEADER -->
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp"
        android:layout_alignParentTop="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:layout_marginTop="15dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_chevron_left"
                android:padding="6dp"
                android:background="@drawable/bg_input_rounded"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="La Maison"
                android:fontFamily="@font/parisienne"
                android:textSize="28sp"
                android:textColor="#FFFFFF" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MANAGER DASHBOARD"
            android:fontFamily="@font/playfair_display"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:letterSpacing="0.15"
            android:layout_gravity="center"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvHubTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Maintenance Inbox"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- 2. SCROLLABLE WORKSPACE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topHeader"
        android:layout_above="@id/bottom_navigation_maintenance"
        android:background="@drawable/bg_sheet_light_grey"
        android:orientation="vertical">

        <!-- 1-BUTTON DYNAMIC FILTER BAR -->
        <LinearLayout
            android:id="@+id/layoutDateFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="8dp">

            <!-- Section Label (Shows ACTIVE TICKETS or RESOLVED & ARCHIVED) -->
            <TextView
                android:id="@+id/tvSectionLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ACTIVE TICKETS"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <!-- Compact Pill Action Button (Toggles between FILTER & CLEAR) -->
            <TextView
                android:id="@+id/btnFilterLog"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="FILTER"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_signout"
                android:backgroundTint="#0F172A"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:drawableStart="@android:drawable/ic_menu_today"
                android:drawablePadding="6dp"
                android:drawableTint="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />
        </LinearLayout>

        <!-- MAINTENANCE TICKETS RECYCLER VIEW -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvManagerTickets"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp"
            android:overScrollMode="never" />
    </LinearLayout>

    <!-- 3. BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation_maintenance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        app:elevation="16dp"
        app:menu="@menu/maintenance_nav_bottom_menu" />

</RelativeLayout>