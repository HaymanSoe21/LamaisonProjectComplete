<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_white"
    android:elevation="2dp"
    android:padding="20dp"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvUnitBuilding"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Loading..."
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:textAllCaps="true"/>

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETTLED"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#16A34A"
            android:background="#DCFCE7"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvTenantName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading..."
        android:fontFamily="@font/playfair_display"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:layout_marginBottom="16dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:layout_marginBottom="16dp"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_marginBottom="20dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:layout_marginBottom="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CURRENT BALANCE" android:textSize="9sp" android:textStyle="bold" android:textColor="#94A3B8"/>
            <TextView android:id="@+id/tvBalance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$0.00" android:textSize="14sp" android:textStyle="bold" android:textColor="#0F172A"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:layout_marginBottom="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LEASE EXPIRY" android:textSize="9sp" android:textStyle="bold" android:textColor="#94A3B8"/>
            <TextView android:id="@+id/tvExpiry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loading..." android:textSize="14sp" android:textStyle="bold" android:textColor="#0F172A"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LAST REMITTANCE" android:textSize="9sp" android:textStyle="bold" android:textColor="#94A3B8"/>
            <TextView android:id="@+id/tvLastRemit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N/A" android:textSize="14sp" android:textStyle="bold" android:textColor="#0F172A"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PAYMENT METHOD" android:textSize="9sp" android:textStyle="bold" android:textColor="#94A3B8"/>
            <TextView android:id="@+id/tvPayMethod" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N/A" android:textSize="14sp" android:textStyle="bold" android:textColor="#0F172A"/>
        </LinearLayout>
    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnLedgerHistory"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Ledger History"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:backgroundTint="#0F172A"
            app:cornerRadius="12dp"
            android:layout_marginEnd="6dp"
            android:textSize="13sp"
            android:elevation="2dp" />

        <Button
            android:id="@+id/btnContact"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Contact"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#475569"
            app:backgroundTint="#F8FAFC"
            app:cornerRadius="12dp"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:elevation="0dp" />

    </LinearLayout>
</LinearLayout>